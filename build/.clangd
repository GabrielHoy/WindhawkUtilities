# Bundles here are generated by scripts/wh-amalgamate.ps1 and contain a copy of
# every symbol in mods/ and shared/. Letting clangd index them would double up
# every definition, so navigation would offer us the generated file as often as
# the real source in-dev. Skip them: the sources they were built from are indexed.
If:
  PathMatch: .*
Index:
  Background: Skip
